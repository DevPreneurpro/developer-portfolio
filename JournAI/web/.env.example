# Copy this file to .env and fill in your own key.
# .env is gitignored — never commit your real key.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Companion avatar generation (portrait + idle/talking video clips).
# Get these at console.higgsfield.ai — a separate product/wallet from a
# regular Higgsfield plan. Leave unset and the avatar endpoints just
# return 503; everything else still works.
HIGGSFIELD_KEY_ID=your-higgsfield-key-id-here
HIGGSFIELD_KEY_SECRET=your-higgsfield-key-secret-here

# Optional
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
